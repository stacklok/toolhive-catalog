          },
          "oauth_config": {
            "authorize_url": "https://api.truthifi.com/oauth/authorize",
            "token_url": "https://api.truthifi.com/oauth/token",
            "scopes": [
              "offline_access"
            ],
            "use_pkce": true
          },
          "overview": "## Truthifi (Remote)\n\nTruthifi's hosted MCP server lets AI assistants read a user's linked investment and bank accounts across 18,000+ institutions. It returns holdings on any date, allocation by asset class, sector and market cap, performance against a benchmark, fees by type, cash flow, linked advisors and the Truthifi Score with its findings. It cannot move money or place trades; three tools change data inside Truthifi only (add or delete a manually tracked asset, refresh a connection). Authentication is OAuth with dynamic client registration.",
          "status": "Active",
          "tags": [
            "remote",
            "finance",
            "portfolio",
            "investing",
            "wealth",
            "fees"
          ],
          "tier": "Official",
          "tools": [
            "get_accounts",
            "get_groups",
            "get_advisors",
            "get_dated_holdings",
            "get_composition",
            "get_equity_concentrations",
            "get_market_cap_allocation",
            "get_balance_history",
            "get_performance_history",
            "get_fees",
            "get_transactions",
            "get_budget_flow_summary",
            "get_investment_transactions_summary",
            "get_asset_liabilities",
            "create_asset_liability",
            "delete_asset_liability",
            "get_findings",
            "get_truthifi_score_history",
            "get_security_info",
            "get_security_distributions",
            "get_security_news",
            "get_truthifi_info",
            "get_prompt_catalog",
            "run_scan",
            "get_scan_status",
            "get_subscription_info",
            "get_subscription_catalog",
            "connect_account",
            "fix_connections",
            "upgrade"
          ]
        }
      }
    }
  },
  "description": "One verified household record for your AI: accounts, holdings, fees and Score. Can't move money.",
