{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "io.github.stacklok": {
        "ghcr.io/stacklok/dockyard/uvx/mcp-server-git:2026.11.18": {
          "metadata": {
            "last_updated": "2026-11-20T00:03:41Z",
            "stars": 84011
          },
          "overview": "## Git MCP Server\n\nThe git-mcp-server is a Model Context Protocol (MCP) server that gives AI assistants direct access to Git repositories through a structured, AI-friendly interface. It enables AI-driven workflows to read repository state, inspect history, and reason about changes without switching tools or manually invoking Git commands. It is especially useful for code understanding, change analysis, release preparation, and development workflows where repository context needs to be embedded directly into an AI assistant.",
          "permissions": {
            "network": {
              "outbound": {}
            }
          },
          "status": "Active",
          "tags": [
            "adds",
            "automation",
            "git",
            "interaction",
            "records",
            "repository",
            "shows",
            "tools",
            "unstages"
          ],
          "tier": "Community",
          "tool_definitions": [
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": false
              },
              "description": "Adds file contents to the staging area",
              "inputSchema": {
                "properties": {
                  "files": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "title": "Files",
                    "type": "array"
                  },
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path",
                  "files"
                ],
                "title": "addArguments",
                "type": "object"
              },
              "name": "git_add"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": true
              },
              "description": "List Git branches",
              "inputSchema": {
                "properties": {
                  "branch_type": {
                    "description": "Whether to list local branches ('local'), remote branches ('remote') or all branches('all').",
                    "title": "Branch Type",
                    "type": "string"
                  },
                  "contains": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The commit sha that branch should contain. Do not pass anything to this param if no commit sha is specified",
                    "title": "Contains"
                  },
                  "not_contains": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The commit sha that branch should NOT contain. Do not pass anything to this param if no commit sha is specified",
                    "title": "Not Contains"
                  },
                  "repo_path": {
                    "description": "The path to the Git repository.",
                    "title": "Repo Path",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path",
                  "branch_type"
                ],
                "title": "branchArguments",
                "type": "object"
              },
              "name": "git_branch"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false,
                "readOnlyHint": false
              },
              "description": "Switches branches",
              "inputSchema": {
                "properties": {
                  "branch_name": {
                    "title": "Branch Name",
                    "type": "string"
                  },
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path",
                  "branch_name"
                ],
                "title": "checkoutArguments",
                "type": "object"
              },
              "name": "git_checkout"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false,
                "readOnlyHint": false
              },
              "description": "Records changes to the repository",
              "inputSchema": {
                "properties": {
                  "message": {
                    "title": "Message",
                    "type": "string"
                  },
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path",
                  "message"
                ],
                "title": "commitArguments",
                "type": "object"
              },
              "name": "git_commit"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false,
                "readOnlyHint": false
              },
              "description": "Creates a new branch from an optional base branch or commit",
              "inputSchema": {
                "properties": {
                  "base_branch": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Branch, tag or commit SHA to create the branch from. Defaults to the current branch, or to the current commit when HEAD is detached",
                    "title": "Base Branch"
                  },
                  "branch_name": {
                    "title": "Branch Name",
                    "type": "string"
                  },
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path",
                  "branch_name"
                ],
                "title": "create_branchArguments",
                "type": "object"
              },
              "name": "git_create_branch"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": true
              },
              "description": "Shows differences between branches or commits, or across a revision range (main..feature, main...feature)",
              "inputSchema": {
                "properties": {
                  "context_lines": {
                    "default": 3,
                    "title": "Context Lines",
                    "type": "integer"
                  },
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  },
                  "target": {
                    "title": "Target",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path",
                  "target"
                ],
                "title": "diffArguments",
                "type": "object"
              },
              "name": "git_diff"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": true
              },
              "description": "Shows changes that are staged for commit",
              "inputSchema": {
                "properties": {
                  "context_lines": {
                    "default": 3,
                    "title": "Context Lines",
                    "type": "integer"
                  },
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path"
                ],
                "title": "diff_stagedArguments",
                "type": "object"
              },
              "name": "git_diff_staged"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": true
              },
              "description": "Shows changes in the working directory that are not yet staged",
              "inputSchema": {
                "properties": {
                  "context_lines": {
                    "default": 3,
                    "title": "Context Lines",
                    "type": "integer"
                  },
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path"
                ],
                "title": "diff_unstagedArguments",
                "type": "object"
              },
              "name": "git_diff_unstaged"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": true
              },
              "description": "Shows the commit logs",
              "inputSchema": {
                "properties": {
                  "end_timestamp": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "End timestamp for filtering commits. Accepts: ISO 8601 format (e.g., '2024-01-15T14:30:25'), relative dates (e.g., '2 weeks ago', 'yesterday'), or absolute dates (e.g., '2024-01-15', 'Jan 15 2024')",
                    "title": "End Timestamp"
                  },
                  "max_count": {
                    "default": 10,
                    "description": "Maximum number of commits to show. Must be at least 1.",
                    "minimum": 1,
                    "title": "Max Count",
                    "type": "integer"
                  },
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  },
                  "start_timestamp": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Start timestamp for filtering commits. Accepts: ISO 8601 format (e.g., '2024-01-15T14:30:25'), relative dates (e.g., '2 weeks ago', 'yesterday'), or absolute dates (e.g., '2024-01-15', 'Jan 15 2024')",
                    "title": "Start Timestamp"
                  }
                },
                "required": [
                  "repo_path"
                ],
                "title": "logArguments",
                "type": "object"
              },
              "name": "git_log"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": false
              },
              "description": "Merges a branch into the current branch. Fast-forward only unless fast_forward_only is false; refuses a dirty working tree, and aborts a merge that conflicts, leaving the repository unchanged",
              "inputSchema": {
                "properties": {
                  "fast_forward_only": {
                    "default": true,
                    "description": "Only fast-forward, failing if the branches have diverged. False allows a merge commit",
                    "title": "Fast Forward Only",
                    "type": "boolean"
                  },
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  },
                  "source_branch": {
                    "description": "Branch, tag or commit to merge into the current branch",
                    "title": "Source Branch",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path",
                  "source_branch"
                ],
                "title": "mergeArguments",
                "type": "object"
              },
              "name": "git_merge"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": true
              },
              "description": "Lists the repository's remotes with their fetch and push URLs, like `git remote -v`. Credentials embedded in a URL's userinfo, query values or fragment are shown as \u003credacted\u003e; path segments are shown as configured",
              "inputSchema": {
                "properties": {
                  "repo_path": {
                    "description": "The path to the Git repository.",
                    "title": "Repo Path",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path"
                ],
                "title": "remoteArguments",
                "type": "object"
              },
              "name": "git_remote"
            },
            {
              "annotations": {
                "destructiveHint": true,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": false
              },
              "description": "Unstages all staged changes",
              "inputSchema": {
                "properties": {
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path"
                ],
                "title": "resetArguments",
                "type": "object"
              },
              "name": "git_reset"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": true
              },
              "description": "Shows the contents of a commit, or of a file or directory given as \u003crevision\u003e:\u003cpath\u003e",
              "inputSchema": {
                "properties": {
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  },
                  "revision": {
                    "title": "Revision",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path",
                  "revision"
                ],
                "title": "showArguments",
                "type": "object"
              },
              "name": "git_show"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": true
              },
              "description": "Shows the working tree status",
              "inputSchema": {
                "properties": {
                  "repo_path": {
                    "title": "Repo Path",
                    "type": "string"
                  }
                },
                "required": [
                  "repo_path"
                ],
                "title": "statusArguments",
                "type": "object"
              },
              "name": "git_status"
            }
          ],
          "tools": [
            "git_add",
            "git_branch",
            "git_checkout",
            "git_commit",
            "git_create_branch",
            "git_diff",
            "git_diff_staged",
            "git_diff_unstaged",
            "git_log",
            "git_merge",
            "git_remote",
            "git_reset",
            "git_show",
            "git_status"
          ]
        }
      }
    }
  },
