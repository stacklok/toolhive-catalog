          },
          "overview": "## Time MCP Server\n\nThe time MCP server provides time information and IANA timezone conversions with auto system timezone detection. The server leverages Python's timezone libraries to deliver current time queries across any IANA timezone with automatic detection of the system's local timezone when none is specified, time conversion capabilities between different timezones, timezone-aware datetime strings formatted in ISO 8601 standard, and Daylight Saving Time indicators. The server exposes two primary tools: get_current_time and convert_time.",
          "permissions": {
            "network": {
              "outbound": {}
            }
          },
          "status": "Active",
          "tags": [
            "auto",
            "available",
            "configuration",
            "conversions",
            "convert_time",
            "customization",
            "details",
            "detection",
            "example",
            "examples"
          ],
          "tier": "Community",
          "tool_definitions": [
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": true
              },
              "description": "Convert time between timezones",
              "inputSchema": {
                "properties": {
                  "source_timezone": {
                    "default": "Etc/UTC",
                    "description": "Source IANA timezone name (e.g., 'America/New_York', 'Europe/London'). Optional: defaults to the server's local timezone, 'Etc/UTC', when omitted.",
                    "title": "Source Timezone",
                    "type": "string"
                  },
                  "target_timezone": {
                    "default": "Etc/UTC",
                    "description": "Target IANA timezone name (e.g., 'Asia/Tokyo', 'America/San_Francisco'). Optional: defaults to the server's local timezone, 'Etc/UTC', when omitted.",
                    "title": "Target Timezone",
                    "type": "string"
                  },
                  "time": {
                    "description": "Time to convert in 24-hour format (HH:MM)",
                    "title": "Time",
                    "type": "string"
                  }
                },
                "required": [
                  "time"
                ],
                "title": "convert_timeArguments",
                "type": "object"
              },
              "name": "convert_time"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": true
              },
              "description": "Get current time in a specific timezone",
              "inputSchema": {
                "properties": {
                  "timezone": {
                    "default": "Etc/UTC",
                    "description": "IANA timezone name (e.g., 'America/New_York', 'Europe/London'). Optional: defaults to the server's local timezone, 'Etc/UTC', when omitted.",
                    "title": "Timezone",
                    "type": "string"
                  }
                },
                "required": [],
                "title": "get_current_timeArguments",
                "type": "object"
              },
              "name": "get_current_time"
            },
            {
              "annotations": {
                "destructiveHint": false,
                "idempotentHint": true,
                "openWorldHint": false,
                "readOnlyHint": true
              },
              "description": "Get the time a given number of days, hours, minutes and seconds ago in a specific timezone",
              "inputSchema": {
                "properties": {
                  "days_ago": {
                    "default": 0,
                    "description": "Whole days before now",
                    "minimum": 0,
                    "title": "Days Ago",
                    "type": "integer"
                  },
                  "hours_ago": {
                    "default": 0,
                    "description": "Whole hours before now",
                    "minimum": 0,
                    "title": "Hours Ago",
                    "type": "integer"
                  },
                  "minutes_ago": {
                    "default": 0,
                    "description": "Whole minutes before now",
                    "minimum": 0,
                    "title": "Minutes Ago",
                    "type": "integer"
                  },
                  "seconds_ago": {
                    "default": 0,
                    "description": "Whole seconds before now",
                    "minimum": 0,
                    "title": "Seconds Ago",
                    "type": "integer"
                  },
                  "timezone": {
                    "default": "Etc/UTC",
                    "description": "IANA timezone name (e.g., 'America/New_York', 'Europe/London'). Optional: defaults to the server's local timezone, 'Etc/UTC', when omitted.",
                    "title": "Timezone",
                    "type": "string"
                  }
                },
                "required": [],
                "title": "get_time_agoArguments",
                "type": "object"
              },
              "name": "get_time_ago"
